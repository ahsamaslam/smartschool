# ============================================================
# Smart School – Root .gitignore
# ============================================================

# ----- Python -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

# Virtual environments
venv/
env/
ENV/
.venv/
wav2lip_env/

# Packaging / distribution
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.dmypy.json
.ruff_cache/
.pytype/
.pyre/

# Misc Python tools
.ipynb_checkpoints
profile_default/
ipython_config.py
celerybeat-schedule
celerybeat.pid

# ----- Node / Frontend --------------------------------------
node_modules/
frontend/dist/
frontend/build/
.pnp
.pnp.js

# ----- Environment & secrets --------------------------------
.env
.env.local
.env.*.local
*.env
secrets.json

# ----- Generated / uploaded media ---------------------------
backend/static/videos/
backend/static/audio/
backend/static/teacher_faces/
static/videos/
static/audio/

# ----- Wav2Lip weights (large binary files) -----------------
wav2lip_setup/checkpoints/*.pth
wav2lip_setup/Wav2Lip/checkpoints/*.pth
wav2lip_setup/Wav2Lip/results/
wav2lip_setup/Wav2Lip/temp/
wav2lip_setup/Wav2Lip/evaluation/

# ----- Logs -------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ----- IDE / OS ---------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ----- Docker volumes / local DB ----------------------------
postgres_data/
mysql_data/
redis_data/

# ----- Local SQLite / DB files ------------------------------
*.db
*.sqlite

# ----- Mobile app ------------------------------------------
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/android/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/.cxx/
mobile/android/app/build/
mobile/.metro-health-check*

# ----- Graphify output -------------------------------------
graphify-out/cache/

# ----- Temp scripts / one-off files ------------------------
reset_pw.py
*.tmp

# ----- OS / misc -------------------------------------------
desktop.ini
Thumbs.db
.DS_Store
*.sqlite3

# ----- Graphify (all generated files except the text report) -
graphify-out/.graphify_*
graphify-out/cache/
graphify-out/graph.json
graphify-out/graph.html

# ----- Temp / backup files ----------------------------------
*.tmp
*.bak
*.orig
*.pid

# ----- Python version / env managers -----------------------
.python-version
Pipfile.lock
pip-wheel-metadata/
__pypackages__/

# ----- TypeScript build info --------------------------------
*.tsbuildinfo

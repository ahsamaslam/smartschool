# ============================================
# LOCAL DEVELOPMENT — Docker Compose
# Copy this file to backend/.env and fill in ANTHROPIC_API_KEY
# ============================================

# Application
APP_NAME=Education Platform
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Database — matches docker-compose postgres service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_school

# Redis — matches docker-compose redis service
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Claude API — add your key here
ANTHROPIC_API_KEY=your-anthropic-api-key

# Supabase — not needed for local Docker, keep blank or remove
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

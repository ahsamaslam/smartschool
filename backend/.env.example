# ============================================
# EDUCATION PLATFORM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================

# Application
APP_NAME=Education Platform
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Admin bootstrap user (created/updated on startup)
ADMIN_ID=00000000-0000-0000-0000-000000000001
ADMIN_EMAIL=admin@mail.com
ADMIN_FULL_NAME=System Admin
ADMIN_ROLE=admin
ADMIN_PASSWORD=Admin@123
DEACTIVATE_NON_ADMIN_USERS=True

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379/0
# For Upstash: redis://default:your-password@your-endpoint.upstash.io:6379

# JWT Secret for local auth (if not using Supabase Auth)
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Claude API
ANTHROPIC_API_KEY=your-claude-api-key

# Cloudflare R2 (for video storage)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=education-videos
R2_PUBLIC_URL=https://your-bucket.r2.cloudflarestorage.com

# Email Configuration (optional for dev)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@education.com

# ElevenLabs (for AI voice - optional)
ELEVENLABS_API_KEY=your-elevenlabs-key

# D-ID (for avatar videos - optional)
DID_API_KEY=your-did-api-key

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# File Upload Limits
MAX_FILE_SIZE_MB=100
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,mkv
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif

# Caching
CACHE_DEFAULT_TIMEOUT=300
QA_CACHE_TIMEOUT=86400

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

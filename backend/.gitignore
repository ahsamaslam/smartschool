# ============================================================
# Smart School Backend .gitignore
# ============================================================

# ----- Python bytecode / cache -----------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# ----- Virtual environments --------------------------------
venv/
env/
ENV/
.venv/

# ----- Environment & secrets -------------------------------
.env
.env.local
*.env

# ----- Generated media (runtime-created, not source code) --
static/videos/
static/audio/
static/teacher_faces/

# ----- Logs & temp -----------------------------------------
*.log
logs/

# ----- Distribution / packaging ----------------------------
dist/
build/
*.egg-info/

# ----- Tests / coverage ------------------------------------
.coverage
htmlcov/
.pytest_cache/

# ----- Local DB / temp ------------------------------------
*.db
*.sqlite
*.sqlite3
*.tmp
*.bak
*.pid

# ----- Python version / env managers ----------------------
.python-version
pip-wheel-metadata/
__pypackages__/

# ----- IDE / OS --------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
